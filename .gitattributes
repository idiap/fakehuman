* text=auto eol=lf
# Frozen manifests validate the exact bytes of five Python source files.
src/fakehuman/*.py text eol=lf
# Bundled JSON retains its exact bytes.
src/fakehuman/data/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Store the dependency lock with Git LFS.
uv.lock filter=lfs diff=lfs merge=lfs -text
